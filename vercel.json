{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ],
    "cleanUrls": true,
    "redirects": [
        {
            "has": [
                {
                    "type": "host",
                    "value": "dimau-ventures.vercel.app"
                }
            ],
            "source": "/(.*)",
            "statusCode": 308,
            "destination": "https://dimauventures.com/$1"
        }
    ]
}

